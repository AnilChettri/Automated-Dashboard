# ============================================
# Decision Intelligence System - Environment
# ============================================

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL=sqlite+aiosqlite:///./data/intelligence.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/intelligence

# Application
APP_NAME=Decision Intelligence System
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-random-secret-key

# Server
HOST=0.0.0.0
PORT=8000

# ML Configuration
ML_MODELS_DIR=./ml/models
ML_RETRAIN_SCHEDULE=daily

# FAISS Vector Store
VECTOR_STORE_PATH=./data/vector_store

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Render Deployment
RENDER_EXTERNAL_URL=
